{
  "name": "klared",
  "version": "1.1.0",
  "description": "TUI interactiva para instalar y administrar túneles cloudflared en k3s con afinidad por agente y contrato tsure.io/*",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "klared": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:sea": "node scripts/build-sea.mjs",
    "build:sea:linux": "node scripts/build-sea.mjs --target linux",
    "build:sea:win": "node scripts/build-sea.mjs --target win"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.0"
  }
}
